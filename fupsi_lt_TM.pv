free c: channel.
free c_mpc_server: channel [private].
free c_mpc_client: channel [private].
free c_mpc_result: channel [private].

type radius.
type layer.
type timestamp.
type cell.
type block.
type okvs.
type public_param.
type token.

free R: radius.
free layer0: layer.
free t0: timestamp.
free g: public_param.
free h: public_param.
free one: bitstring.

free xy_hit: bitstring [private].
free q_non_candidate: bitstring [private].
free z_non_candidate: bitstring [private].
free triple_non_candidate: bitstring [private].

weaksecret q_non_candidate.
weaksecret triple_non_candidate.
noninterf q_non_candidate, triple_non_candidate.

fun point(bitstring, bitstring): bitstring [data].
fun triple(bitstring, bitstring, bitstring): bitstring [data].
fun cell_id(bitstring, radius): cell.
fun xy_cell(bitstring, radius): cell.
equation forall xy: bitstring, z: bitstring, r: radius;
    cell_id(point(xy, z), r) = xy_cell(xy, r).
fun block_id(cell, layer): block.
fun triple_block(bitstring, radius, layer): block.

fun okvs_encode(block, block, public_param): okvs.
reduc forall b_hit: block, b_other: block, v: public_param;
    okvs_decode(okvs_encode(b_hit, b_other, v), b_hit) = v.

fun rerand(public_param, public_param): public_param.
fun ddh_value(public_param, public_param): bitstring [private].
fun tag_hash(bitstring): bitstring.
fun label_of(layer, timestamp, block): token.
fun mask_label(token, bitstring): bitstring.
fun label_key(bitstring, token): bitstring.
reduc forall l: token, k: bitstring;
    unmask_label(mask_label(l, k), k) = l.

fun init_msg(public_param, public_param, okvs): bitstring [data].
fun sender_item(token, public_param, bitstring, bitstring): bitstring [data].
fun msg_3(token, bitstring, bitstring): bitstring [data].

fun reply_auth(bitstring, token, bitstring): bitstring.
fun final_result(token, bitstring): bitstring [data].

fun mpc_server_input(token, bitstring): bitstring [data].
fun mpc_client_input(token, bitstring): bitstring [data].
fun mpc_result(token, bitstring): bitstring [data].

fun ideal_mpc_count(bitstring, bitstring): bitstring [private].

event senderItemBuilt(token).
event coarseCandidate(token).
event msg3Aligned(token).
event mpcChecked(token).
event mpcCount(token, bitstring).
event resultAccepted(token, bitstring).

query attacker(q_non_candidate).
query attacker(point(q_non_candidate, z_non_candidate)).
query attacker(triple_non_candidate).
query cid: token; event(coarseCandidate(cid)) ==> event(senderItemBuilt(cid)).
query cid: token; event(msg3Aligned(cid)) ==> event(coarseCandidate(cid)).
query cid: token, n: bitstring;
    event(resultAccepted(cid, n)) ==>
    event(coarseCandidate(cid)) && event(msg3Aligned(cid)) &&
    event(mpcChecked(cid)) && event(mpcCount(cid, n)).

let uavA() =
    new zA: bitstring;
    new beforeA: bitstring;
    new afterA: bitstring;
    new ppA: public_param;
    let posA = point(xy_hit, zA) in
    let cellA = cell_id(posA, R) in
    let blockA = block_id(cellA, layer0) in
    let otherBlockA = triple_block(triple_non_candidate, R, layer0) in
    let E = okvs_encode(blockA, otherBlockA, ppA) in
    out(c, init_msg(g, h, E));

    in(c, sender_item(cidA: token, uB: public_param,
                      tagB: bitstring, masked_label: bitstring));
    let dhA = ddh_value(uB, ppA) in
    if tagB = tag_hash(dhA) then
        let recovered = unmask_label(masked_label, label_key(dhA, cidA)) in
        if recovered = label_of(layer0, t0, blockA) then
            event coarseCandidate(cidA);
            out(c, msg_3(cidA, one, reply_auth(dhA, cidA, one)));
            out(c_mpc_server,
                mpc_server_input(cidA, triple(beforeA, posA, afterA))).

let uavB() =
    in(c, init_msg(gA: public_param, hA: public_param, EA: okvs));
    new zB: bitstring;
    let posB = point(xy_hit, zB) in
    let cellB = cell_id(posB, R) in
    let blockB = block_id(cellB, layer0) in
    let decoded = okvs_decode(EA, blockB) in
    new cidB: token;
    let uB = rerand(gA, decoded) in
    let dhB = ddh_value(uB, decoded) in
    let labelB = label_of(layer0, t0, blockB) in
    let maskedB = mask_label(labelB, label_key(dhB, cidB)) in
    event senderItemBuilt(cidB);

    new cidMiss: token;
    new ppMiss: public_param;
    new tMiss: timestamp;
    let missPoint = point(q_non_candidate, z_non_candidate) in
    let missBlock = block_id(cell_id(missPoint, R), layer0) in
    let uMiss = rerand(gA, ppMiss) in
    let dhMiss = ddh_value(uMiss, ppMiss) in
    let missLabel = label_of(layer0, tMiss, missBlock) in
    event senderItemBuilt(cidMiss);
    out(c, sender_item(cidMiss, uMiss, tag_hash(dhMiss),
                       mask_label(missLabel, label_key(dhMiss, cidMiss))));
    out(c, sender_item(cidB, uB, tag_hash(dhB), maskedB));

    in(c, msg_3(=cidB, =one, =reply_auth(dhB, cidB, one)));
    event msg3Aligned(cidB);
    out(c_mpc_client, mpc_client_input(cidB, posB));
    in(c_mpc_result, mpc_result(=cidB, n: bitstring));
    event resultAccepted(cidB, n);
    out(c, final_result(cidB, n)).

let idealMPC() =
    in(c_mpc_server, mpc_server_input(cid: token, sTriple: bitstring));
    in(c_mpc_client, mpc_client_input(=cid, queryPoint: bitstring));
    event mpcChecked(cid);
    let n = ideal_mpc_count(sTriple, queryPoint) in
    event mpcCount(cid, n);
    out(c_mpc_result, mpc_result(cid, n)).

process
    uavA() | uavB() | idealMPC()
